{
  "nodeModulesDir": "manual",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 110,
    "include": [
      "src/",
      "scripts/"
    ]
  },
  "lint": {
    "include": [
      "src/",
      "scripts/"
    ]
  }
}
